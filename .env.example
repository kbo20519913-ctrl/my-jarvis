# Frontend (Vite). Safe to expose: anon key is designed for the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Netlify Functions only. Never prefix these with VITE_.
ANTHROPIC_API_KEY=
# AI Studio key (AQ....) is for Gemini web grounding. Cloud Console key (AIza...) is for Custom Search.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Optional dedicated Custom Search key. Do not reuse a YouTube-only restricted key.
# GOOGLE_CSE_API_KEY=
YOUTUBE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
